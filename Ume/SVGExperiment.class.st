Class {
	#name : 'SVGExperiment',
	#superclass : 'GrammarBasePathologicalBugMutatorPaperExperiment',
	#category : 'Ume-Paper Experimentation',
	#package : 'Ume',
	#tag : 'Paper Experimentation'
}

{ #category : 'running' }
SVGExperiment >> maxInputSize [

	^ 1000
]

{ #category : 'running' }
SVGExperiment >> methodsToInstrument [

	^ RSSVGPath package methods
]

{ #category : 'running' }
SVGExperiment >> name [

	^ 'PharoSVGs'
]

{ #category : 'running' }
SVGExperiment >> newGrammar [

	^ SvgPathGrammar new
]

{ #category : 'running' }
SVGExperiment >> schemaCorpusWith: mutators selector: selector [

	| svgGenerator |
	
	svgGenerator := self corpusGenerator: mutators selector: selector.

	^ UmeSchema new
		receiverConstraint: (UmeConstantGenerator new value: SVGRunner);
		argumentConstraints: { svgGenerator };
		property: [ :regex :input :result | true ].
]

