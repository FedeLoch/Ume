{ #category : 'running' }
SVGExperiment >> targetMethod [

	^ SVGRunner class >> #run:
]

{ #category : 'running' }
SVGExperiment >> weightedGrammarSchema [

	| svgGenerator |
	
	svgGenerator := UmeGrammarGenerator new grammar: self newGrammar; maxSize: self maxInputSize.

	^ UmeSchema new
		receiverConstraint: (UmeConstantGenerator new value: SVGRunner);
		argumentConstraints: { svgGenerator };
		property: [ :regex :input :result | true ].
]
